{
  "persistence": {
    "enabled": true,
    "auto_save": true,
    "max_history_days": 30,
    "db_path": ".clean-ctx/persistence.db"
  },
  "cache": {
    "enabled": true,
    "system_prompt_ttl": "1h",
    "tools_ttl": "1h",
    "baseline_ttl": "1h",
    "tail_ttl": "5m",
    "vocab_version": "v1",
    "tool_defs_version": "v1"
  },
  "cbm": {
    "enabled": true
  },
  "type_aliases": {
    "UserId": "$uid",
    "JsonObject": "$jo",
    "HttpClient": "$http"
  }
}
