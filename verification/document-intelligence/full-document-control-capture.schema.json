{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clean-ctx.local/schemas/document-intelligence-control-capture-v1.json",
  "title": "Clean-CTX document-intelligence full-document control capture",
  "type": "object",
  "required": ["schema", "version", "manifestVersion", "oracleVersion", "status", "run", "protocol", "tasks", "summary"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "clean-ctx/document-intelligence-control-capture" },
    "version": { "const": 1 },
    "manifestVersion": { "type": "integer", "minimum": 1 },
    "oracleVersion": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["planned", "prepared", "in_progress", "captured", "complete"] },
    "run": { "$ref": "#/$defs/run" },
    "protocol": { "$ref": "#/$defs/protocol" },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/taskCapture" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "nullableNonNegativeInteger": { "type": ["integer", "null"], "minimum": 0 },
    "run": {
      "type": "object",
      "required": ["id", "repositoryRevision", "worktreeState", "preparedAt", "startedAt", "completedAt", "executor", "provider", "model", "reportedModelVersion", "client", "clientVersion", "parameters"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/nullableString" },
        "repositoryRevision": { "$ref": "#/$defs/nullableString" },
        "worktreeState": { "enum": ["clean", "dirty", "unknown"] },
        "preparedAt": { "type": ["string", "null"], "format": "date-time" },
        "startedAt": { "type": ["string", "null"], "format": "date-time" },
        "completedAt": { "type": ["string", "null"], "format": "date-time" },
        "executor": { "$ref": "#/$defs/nullableString" },
        "provider": { "$ref": "#/$defs/nullableString" },
        "model": { "$ref": "#/$defs/nullableString" },
        "reportedModelVersion": { "$ref": "#/$defs/nullableString" },
        "client": { "$ref": "#/$defs/nullableString" },
        "clientVersion": { "$ref": "#/$defs/nullableString" },
        "parameters": {
          "type": "object",
          "required": ["temperature", "topP", "seed", "maxOutputTokens", "reasoningEffort", "other"],
          "additionalProperties": false,
          "properties": {
            "temperature": { "type": ["number", "null"] },
            "topP": { "type": ["number", "null"] },
            "seed": { "type": ["integer", "null"] },
            "maxOutputTokens": { "type": ["integer", "null"], "minimum": 1 },
            "reasoningEffort": { "$ref": "#/$defs/nullableString" },
            "other": { "type": "object" }
          }
        }
      }
    },
    "protocol": {
      "type": "object",
      "required": ["id", "promptVersion", "taskInputPolicy", "transport", "freshConversationPerTask", "oracleHiddenDuringCapture"],
      "additionalProperties": false,
      "properties": {
        "id": { "const": "full-document-control-v1" },
        "promptVersion": { "const": 1 },
        "taskInputPolicy": { "const": "allowlisted_non_evaluation_fields_v1" },
        "transport": { "enum": ["role_messages", "concatenated", "unknown"] },
        "freshConversationPerTask": { "const": true },
        "oracleHiddenDuringCapture": { "const": true }
      }
    },
    "sourceDocument": {
      "type": "object",
      "required": ["id", "path", "sha256", "bytes", "tokens"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 },
        "tokens": {
          "type": "object",
          "required": ["cl100k", "o200k"],
          "additionalProperties": false,
          "properties": {
            "cl100k": { "type": "integer", "minimum": 0 },
            "o200k": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "prompt": {
      "type": "object",
      "required": ["systemText", "userText", "systemSha256", "userSha256", "transportText", "transportSha256"],
      "additionalProperties": false,
      "properties": {
        "systemText": { "$ref": "#/$defs/nullableString" },
        "userText": { "$ref": "#/$defs/nullableString" },
        "systemSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "userSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "transportText": { "$ref": "#/$defs/nullableString" },
        "transportSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "usage": {
      "type": "object",
      "required": ["source", "inputTokens", "outputTokens", "totalTokens"],
      "additionalProperties": false,
      "properties": {
        "source": { "enum": ["provider_reported", "locally_measured", "unavailable"] },
        "inputTokens": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "outputTokens": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "totalTokens": { "$ref": "#/$defs/nullableNonNegativeInteger" }
      }
    },
    "output": {
      "type": "object",
      "required": ["answer", "latencyMs", "finishReason", "truncated", "retryCount", "usage", "error"],
      "additionalProperties": false,
      "properties": {
        "answer": { "$ref": "#/$defs/nullableString" },
        "latencyMs": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "finishReason": { "$ref": "#/$defs/nullableString" },
        "truncated": { "type": ["boolean", "null"] },
        "retryCount": { "type": "integer", "minimum": 0 },
        "usage": { "$ref": "#/$defs/usage" },
        "error": { "$ref": "#/$defs/nullableString" }
      }
    },
    "review": {
      "type": "object",
      "required": ["verdict", "reviewer", "reviewedAt", "oracleComparison", "notes"],
      "additionalProperties": false,
      "properties": {
        "verdict": { "enum": ["pending", "pass", "partial", "fail", "ambiguous"] },
        "reviewer": { "$ref": "#/$defs/nullableString" },
        "reviewedAt": { "type": ["string", "null"], "format": "date-time" },
        "oracleComparison": { "$ref": "#/$defs/nullableString" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "taskCapture": {
      "type": "object",
      "required": ["task", "status"],
      "additionalProperties": false,
      "properties": {
        "task": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pending", "completed", "skipped", "error"] },
        "sourceDocuments": { "type": "array", "items": { "$ref": "#/$defs/sourceDocument" } },
        "prompt": { "$ref": "#/$defs/prompt" },
        "output": { "$ref": "#/$defs/output" },
        "review": { "$ref": "#/$defs/review" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "not": { "const": "pending" } } },
            "required": ["status"]
          },
          "then": {
            "required": ["sourceDocuments", "prompt", "output", "review"]
          }
        }
      ]
    },
    "summary": {
      "type": "object",
      "required": ["total", "pending", "completed", "skipped", "error", "pass", "partial", "fail", "ambiguous"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "pending": { "type": "integer", "minimum": 0 },
        "completed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "error": { "type": "integer", "minimum": 0 },
        "pass": { "type": "integer", "minimum": 0 },
        "partial": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "ambiguous": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
