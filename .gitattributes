# Normalize text file handling. See docs/ENCODING_POLICY.md.
* text=auto

# The Unicode canary fixture is byte-compared by src/tests/encoding.rs and
# MUST always be checked out with LF endings only (no CR bytes).
src/test_files/unicode_canary.txt text eol=lf

# Complete-query fixtures match Rust string literals, whose line endings are LF.
src/tests/compression/fixtures/core_ir_typescript_before.scm text eol=lf
src/tests/compression/fixtures/core_ir_csharp_before.scm text eol=lf

# PowerShell scripts: CRLF on all platforms.
*.ps1 text eol=crlf

# Versioned Git hooks are POSIX shell scripts and MUST stay LF (a CR would
# break the shebang when git runs the hook).
.githooks/* text eol=lf

# OPS-R1 adapters, manifests and retained evidence use exact-byte SHA-256 pins.
# Preserve their authored UTF-8 bytes across checkouts; encoding guards still apply.
verification/ops-r1/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Retain the repository's existing PowerShell checkout policy.
verification/ops-r1/**/*.ps1 text eol=crlf
